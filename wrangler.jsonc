// The app on Cloudflare: Workers static assets, no Worker script. Build with
// the plain `npm run build` (base path /), then deploy from the repo root with
//   npx wrangler deploy
// It serves https://coffee-button.<your-subdomain>.workers.dev. Asset requests
// do not run any code, so there is nothing to log or bill per request.
// The Starling relay is a separate Worker: relay-worker/wrangler.jsonc.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coffee-button",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths get index.html, as scripts/serve.mjs does on black-box.
    "not_found_handling": "single-page-application",
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
}
